# Copy to .env and fill in your own broker.
SHIPMENT_BROKER_URL=tcps://YOUR-BROKER.messaging.solace.cloud:55443
SHIPMENT_BROKER_VPN=your-vpn
SHIPMENT_BROKER_USERNAME=your-client-username
SHIPMENT_BROKER_PASSWORD=your-broker-password
SHIPMENT_EVENT_USER=sam_dev_user
# Mock master data API (started with scripts/start-mock-api.sh)
MASTER_DATA_BASE_URL=http://127.0.0.1:8099
