# Copy to .env and fill in your own broker.
TRADE_BROKER_URL=tcps://YOUR-BROKER.messaging.solace.cloud:55443
TRADE_BROKER_VPN=your-vpn
TRADE_BROKER_USERNAME=your-client-username
TRADE_BROKER_PASSWORD=your-broker-password
TRADE_BROKER_REST_URL=https://YOUR-BROKER.messaging.solace.cloud:9443
TRADE_EVENT_USER=sam_dev_user
# Postgres that holds the collected trade events (see README for the container)
TRADE_PG_DSN=postgresql://trades:trades@127.0.0.1:55432/trades
