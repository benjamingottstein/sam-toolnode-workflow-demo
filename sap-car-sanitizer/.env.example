# Copy to .env and fill in your own broker. Any Solace broker works
# (Solace Cloud, a local PubSub+ container, or an existing one).
SAP_BROKER_URL=tcps://YOUR-BROKER.messaging.solace.cloud:55443
SAP_BROKER_VPN=your-vpn
SAP_BROKER_USERNAME=your-client-username
SAP_BROKER_PASSWORD=your-broker-password
# REST messaging endpoint of the same broker - the publish_event tool uses it
SAP_BROKER_REST_URL=https://YOUR-BROKER.messaging.solace.cloud:9443
# Identity the triggered runs are attributed to (any name)
SAP_EVENT_USER=sam_dev_user
# Shared secret for the webhook entrypoint (choose any value)
SAP_WEBHOOK_TOKEN=change-me
